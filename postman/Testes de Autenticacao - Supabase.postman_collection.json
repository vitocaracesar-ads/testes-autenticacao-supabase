          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status HTTP 400\", function () {\r\n    pm.response.to.have.status(400);\r\n});\r\n\r\npm.test(\"Credenciais rejeitadas\", function () {\r\n    const resposta = pm.response.json();\r\n    pm.expect(resposta.error_code).to.eql(\"invalid_credentials\");\r\n});\r\n\r\npm.test(\"Nao retorna access_token\", function () {\r\n    const resposta = pm.response.json();\r\n    pm.expect(resposta).not.to.have.property(\"access_token\");\r\n});"
            ]
